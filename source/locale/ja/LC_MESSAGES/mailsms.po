msgstr "必須"

#: ../../../source/mailsms.rst:25 ../../../source/mailsms.rst:49
msgid "Data Type"
msgstr "データタイプ"

#: ../../../source/mailsms.rst:25 ../../../source/mailsms.rst:49
msgid "Example"
msgstr "例"

