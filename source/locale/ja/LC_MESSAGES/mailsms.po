msgid "DKIM"
msgstr "DKIM"

#: ../../../source/mailsms.rst:29 ../../../source/mailsms.rst:52
msgid "DKIM email security"
msgstr "DKIM メールセキュリティ"

#: ../../../source/mailsms.rst:29 ../../../source/mailsms.rst:52
msgid "PASS"
msgstr "PASS"

#: ../../../source/mailsms.rst:30 ../../../source/mailsms.rst:53
msgid "SPF"
msgstr "SPF"

#: ../../../source/mailsms.rst:30 ../../../source/mailsms.rst:53
msgid "SPF email security"
msgstr "SPFメールセキュリティ"

